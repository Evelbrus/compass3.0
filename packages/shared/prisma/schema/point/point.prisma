model Point {
  uuid              String   @id @default(uuid()) @map("uuid")
  address           String   @unique @map("address")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  pricePerKm        Int      @map("price_per_km")
  airport           Boolean? @map("airport")
  latitude          Float    @map("latitude")
  longitude         Float    @map("longitude")
  terrainDifficulty Float    @default(1.0) @map("terrain_difficulty")

  departureOrders Order[] @relation("departure_orders")
  arrivalOrders   Order[] @relation("arrival_orders")

  @@map("points")
}
