enum OrderStatus {
  PENDING
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  OVERDUE
}

enum DriverAcceptanceStatus {
  PENDING    @map("pending") // Ожидание решения водителя
  TAKEN      @map("taken") // Водитель принял к сведению (готов к выполнению)
  ACCEPTED   @map("accepted") // Водитель принял заказ
  ON_THE_WAY @map("on_the_way") // Водитель в пути к клиенту
  ARRIVED    @map("arrived") // Водитель прибыл к клиенту
  PICKED_UP  @map("picked_up") // Водитель забрал клиента
  TIMEOUT    @map("timeout") // Водитель не принял заказ вовремя
  COMPLETED  @map("completed") // Водитель успешно завершил поездку
}

model Order {
  uuid                          String                           @id @default(uuid()) @map("uuid")
  clientById                    String                           @map("client_by_od")
  clientBy                      User                             @relation("client_orders", fields: [clientById], references: [uuid], onDelete: Cascade)
  tariffUuid                    String                           @map("tariff_id")
  tariff                        Tariff                           @relation("tariffs", fields: [tariffUuid], references: [uuid], onDelete: Cascade)
  departurePointId              String                           @map("departure_point_id")
  departurePoint                Point                            @relation("departure_orders", fields: [departurePointId], references: [uuid], onDelete: Cascade)
  arrivalPointId                String                           @map("arrival_point_id")
  arrivalPoint                  Point                            @relation("arrival_orders", fields: [arrivalPointId], references: [uuid], onDelete: Cascade)
  assignedDriverId              String?                          @map("assigned_driver_id")
  assignedDriver                User?                            @relation("assigned_orders", fields: [assignedDriverId], references: [uuid], onDelete: Cascade)
  status                        OrderStatus                      @default(PENDING) @map("status")
  driverAcceptanceStatus        DriverAcceptanceStatus?          @default(PENDING) @map("driver_acceptance_status")
  basePrice                     Decimal                          @map("base_price")
  finalPrice                    Decimal?                         @map("final_price")
  departureTime                 DateTime                         @map("departure_time")
  createdAt                     DateTime                         @default(now()) @map("created_at")
  updatedAt                     DateTime                         @updatedAt @map("updated_at")
  intermediatePoints            String[]                         @map("intermediate_points")
  orderTariffAdditionalServices OrderOnTariffAdditionalService[]
  description                   String?                          @map("description")
  flightNumber                  String?                          @map("flight_number")
  waitingTimeMinutes            Int                              @default(0) @map("waiting_time_minutes")
  notifications                 Notification[]

  @@map("orders")
}
