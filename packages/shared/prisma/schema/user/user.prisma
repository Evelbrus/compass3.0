enum UserRole {
  Client     @map("client")
  ClientCorp @map("client_corp")
  Driver     @map("driver")
  Operator   @map("operator")
  Admin      @map("admin")
  None       @map("none")
}

enum Gender {
  Male   @map("male")
  Female @map("female")
  None   @map("none")
}

enum PartnerCompany {
  TRANSFER @map("transfer") // Твоя компания "Трансфер"
  YANDEX   @map("yandex") // Яндекс
  UBER     @map("uber") // Убер
  NONE     @map("none") // Нет партнера
}

enum DriverAcceptanceStatus {
  PENDING // 0: Ожидание решения водителя
  TAKEN // 1: Водитель принял к сведению (готов к выполнению)
  REJECTED // 3: Водитель отклонил заказ
  TIMEOUT // 4: Водитель не принял заказ в течение отведенного времени
  ON_THE_WAY // 5: Водитель в пути к клиенту
  ARRIVED // 6: Водитель прибыл к клиенту
  PICKED_UP // 7: Водитель забрал клиента
  COMPLETED // 8: Заказ завершен
  CANCELLED // 9: Заказ отменен
}

model User {
  uuid     String   @id @default(uuid()) @map("uuid")
  email    String   @unique @map("email")
  password String   @map("password")
  role     UserRole @map("role")

  driverAcceptanceStatus DriverAcceptanceStatus @default(PENDING) @map("driver_acceptance_status")

  partnerCompany  PartnerCompany @default(NONE) @map("partner_company") // Партнер пользователя
  PartnerSalary   PartnerSalary? @relation(fields: [partnerSalaryId], references: [uuid])
  partnerSalaryId String?
  defaultSalary   PartnerSalary? @relation("user_default_salary", fields: [defaultSalaryId], references: [uuid]) // Ссылка на общую ставку партнера
  defaultSalaryId String?        @map("default_salary_id") // ID общей ставки

  individualSalaryRate Float?  @map("individual_salary_rate") // Индивидуальная ставка (опционально)
  individualCurrency   String? @default("RUB") @map("individual_currency") // Валюта индивидуальной ставки

  driverProfileId String?        @unique @map("driver_profile_id")
  driverProfile   DriverProfile? @relation("user_to_driver_profile")

  companyProfileId String?         @unique @map("company_profile_id")
  companyProfile   CompanyProfile? @relation("user_to_company_profile")

  LoginAttemptId String?
  LoginAttempt   LoginAttempt[] @relation("login_attempts")

  orders         Order[] @relation("created_orders")
  assignedOrders Order[] @relation("assigned_orders")

  fullName         String  @map("full_name")
  phone            String  @map("phone")
  gender           Gender  @map("gender")
  address          String? @map("address")
  profilePhotoPath String? @map("profile_photo_path")

  vehicleDriverId String?        @map("vehicle_driver_id")
  vehicleDriver   VehicleDriver? @relation("driver_to_vehicle_driver")

  availability Boolean   @default(false) @map("availability")
  lastActive   DateTime? @map("last_active")
  isBlocked    Boolean   @default(false) @map("is_blocked")

  sessionVersion Int      @default(1)
  refreshTokens  String[] @default([]) @map("refresh_tokens")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}
