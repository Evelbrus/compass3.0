model VehicleDriver {
  uuid      String  @id @default(uuid()) @map("uuid")
  vehicle   Vehicle @relation("vehicle_to_vehicle_driver", fields: [vehicleId], references: [uuid], onDelete: Cascade)
  vehicleId String  @map("vehicle_id")

  driverId String @unique @map("driver_id")
  driver   User   @relation("driver_to_vehicle_driver", fields: [driverId], references: [uuid], onDelete: Cascade)

  assignmentDate DateTime @map("assignment_date")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([vehicleId, driverId])
  @@map("vehicle_drivers")
}
