enum Color {
  Other  @map("other")
  White  @map("white")
  Silver @map("silver")
  Gold   @map("gold")
  Black  @map("black")
  Grey   @map("grey")
  Blue   @map("blue")
  Pink   @map("pink")
  Red    @map("red")
  Orange @map("orange")
  Brown  @map("brown")
  Green  @map("green")
  None   @map("none")
}

enum VehicleType {
  Sedan    @map("sedan")
  Minivan  @map("minivan")
  Sprinter @map("sprinter")
  Bus      @map("bus")
  None     @map("none")
}

enum ServiceLevels {
  Basic   @map("basic")
  Premium @map("premium")
  Vip     @map("vip")
  None    @map("none")
}

model Vehicle {
  uuid           String          @id @default(uuid()) @map("uuid")
  vehicleType    VehicleType     @map("vehicle_type")
  brand          String          @map("brand")
  model          String          @map("model")
  year           DateTime?       @map("year")
  color          String          @map("color")
  plateNumber    String          @unique @map("plate_number")
  isAvailable    Boolean         @default(true) @map("is_available")
  photoPath      String?         @map("photo_path")
  serviceLevels  ServiceLevels   @map("service_levels")
  vehicleDrivers VehicleDriver[] @relation("vehicle_to_vehicle_driver")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@map("vehicles")
}
