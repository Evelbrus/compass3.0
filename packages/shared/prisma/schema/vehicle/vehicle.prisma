enum Color {
  Other  @map("other")
  White  @map("white")
  Silver @map("silver")
  Gold   @map("gold")
  Black  @map("black")
  Grey   @map("grey")
  Blue   @map("blue")
  Pink   @map("pink")
  Red    @map("red")
  Orange @map("orange")
  Brown  @map("brown")
  Green  @map("green")
  None   @map("none")
}

enum VehicleType {
  Sedan    @map("sedan")
  Minivan  @map("minivan")
  Microbus @map("microbus") // Микроавтобус
  Bus      @map("bus")
  SUV      @map("suv") // Внедорожник
  None     @map("none")
}

enum ServiceLevels {
  Basic   @map("basic")
  Premium @map("premium")
  Vip     @map("vip")
  None    @map("none")
}

enum Ownership {
  Personal @map("personal") // Личный транспорт водителя
  Fleet    @map("fleet") // Транспорт автопарка
}

model Vehicle {
  uuid                         String          @id @default(uuid()) @map("uuid")
  vehicleType                  VehicleType     @map("vehicle_type")
  brand                        String          @map("brand")
  model                        String          @map("model")
  year                         DateTime?       @map("year")
  color                        String          @map("color")
  plateNumber                  String          @unique @map("plate_number")
  isAvailable                  Boolean         @default(true) @map("is_available")
  photoPath                    String?         @map("photo_path")
  photoRegistrationCertificate String?         @map("photo_registration_certificate")
  serviceLevels                ServiceLevels   @map("service_levels")
  vehicleDrivers               VehicleDriver[] @relation("vehicle_to_vehicle_driver")
  createdAt                    DateTime        @default(now()) @map("created_at")
  updatedAt                    DateTime        @updatedAt @map("updated_at")

  /// Новое поле:
  ownership Ownership @default(Personal) @map("ownership")

  @@map("vehicles")
}
