enum Color {
  Other
  White
  Silver
  Gold
  Black
  Grey
  Blue
  Pink
  Red
  Orange
  Brown
  Green
  None   @map("none")
}

enum VehicleType {
  Coupe
  Minivan
  Sedan
  SUV
  Hatchback
  Wagon
  Van
  Convertible
  Pickup
  Electric
  Hybrid
  None        @map("none")
}

model Vehicle {
  uuid           String                      @id @default(uuid()) @map("uuid")
  vehicleType    VehicleType                 @map("vehicle_type")
  brand          String                      @map("brand")
  model          String                      @map("model")
  year           DateTime?                   @map("year")
  color          Color                       @map("color")
  plateNumber    String                      @unique @map("plate_number")
  isAvailable    Boolean                     @default(true) @map("is_available")
  photoPath      String?                     @map("photo_path")
  vehicleDrivers VehicleDriver[]             @relation("vehicle_to_vehicle_driver")
  createdAt      DateTime                    @default(now()) @map("created_at")
  updatedAt      DateTime                    @updatedAt @map("updated_at")
  service_levels vehicle_on_service_levels[] @relation("VehicleServiceLevels")

  @@map("vehicles")
}
