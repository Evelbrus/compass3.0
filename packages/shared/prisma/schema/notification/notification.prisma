enum Action {
  info // просто уведомление
  noted // уведомление о заказе
  inProgress // заказ в процессе выполнения
  success // заказ успешно выполнен
  warning // заказ в просрочено
  cancelled // заказ отменен
}

model Notification {
  uuid        String   @id @default(uuid())
  userId      String
  createdById String
  driverById  String?
  orderId     String
  title       String
  message     String
  read        Boolean  @default(false)
  action      Action
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("notification")
}
