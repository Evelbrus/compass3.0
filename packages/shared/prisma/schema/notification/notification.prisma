model Notification {
  uuid        String   @id @default(uuid())
  createdById String?
  clientId    String?
  driverId    String?
  orderId     String?
  title       String?
  message     String?
  read        Boolean  @default(false)
  order       Order?   @relation(fields: [orderId], references: [uuid])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("notification")
}
