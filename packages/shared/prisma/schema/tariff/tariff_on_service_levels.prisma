model TariffOnServiceLevels {
  uuid        String       @id @default(uuid()) @map("uuid")
  tariffUuid  String       @map("tariff_uuid")
  tariff      Tariff       @relation("TariffToTariffOnServiceLevels", fields: [tariffUuid], references: [uuid], onDelete: Cascade)
  serviceUuid String       @map("service_uuid")
  service     ServiceLevel @relation("TariffOnServiceLevelsToServiceLevels", fields: [serviceUuid], references: [uuid], onDelete: Cascade)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@map("tariff_on_service_levels")
}
