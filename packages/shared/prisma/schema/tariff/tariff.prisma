model Tariff {
  uuid                       String            @id @default(uuid()) @map("uuid")
  name                       String            @map("name")
  price                      Int               @map("price")
  description                String?           @map("description")
  additionalPointPrice       Int               @map("additional_point_price")
  freeWaitTimeBishkek        Int               @map("free_wait_time_bishkek")
  pricePerMinuteAfterBishkek Int               @map("price_per_minute_after_bishkek")
  freeWaitTimeAirport        Int               @map("free_wait_time_airport")
  pricePerMinuteAfterAirport Int               @map("price_per_minute_after_airport")
  Order                      Order[]           @relation("tariffs")
  tariffAdditionalServices   TariffOnService[] @relation("TariffToTariffOnService")
  serviceLevel               ServiceLevels     @map("service_level")
  vehicleType                VehicleType       @map("vehicle_type")
  createdAt                  DateTime          @default(now()) @map("created_at")
  updatedAt                  DateTime          @updatedAt @map("updated_at")

  @@map("tariffs")
}
