datasource db {
  provider = "postgresql"
  url      = "postgresql://postgres:111@localhost:5432/compass"
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["prismaSchemaFolder", "driverAdapters", "postgresqlExtensions", "relationJoins", "views"]
  schema_folder   = "./schema"
}
