// Enums
enum Citizenship {
  RU   @map("RU") // Россия
  KG   @map("KG") // Кыргызстан
  None @map("none") // Не указано
}

enum IdentityDocument {
  Russian    @map("Russian") // Российский паспорт
  Kyrgyzstan @map("Kyrgyzstan") // Кыргызский паспорт
  None       @map("none") // Не указано
}

enum ChangingDriver {
  Day   @map("day") // Дневной
  Night @map("night") // Ночной
  Both  @map("both") // Оба
  None  @map("none") // Не указано
}

enum Status {
  Free @map("free") // Свободен
  Busy @map("busy") // Занят
  None @map("none") // Не указано
}

// Model
model DriverProfile {
  uuid              String             @id @default(uuid()) @map("uuid")
  citizenship       Citizenship        @map("citizenship")
  identityDocument  IdentityDocument   @map("identity_document")
  passportId        String             @map("passport_id")
  passportIssueDate DateTime?          @map("passport_issue_date")
  passportIssued    String             @map("passport_issued")
  birthDate         DateTime?          @map("birthdate")
  birthPlace        String             @map("birthplace")
  actualAddress     String             @map("actual_address")
  permanentAddress  String             @map("permanent_address")
  changingDriver    ChangingDriver     @map("changing_driver")
  driverExperience  DriverExperience[] @relation("driver_experience")
  yearsOfDriving    Float
  passportPhotoPath String?            @map("passport_photo_path")
  profilePhotoPath  String?            @map("profile_photo_path")
  licensePhotoPath  String?            @map("license_photo_path")
  bankName          String?            @map("bank_name")
  bankBic           String?            @map("bic")
  bankAccountNumber BigInt?            @map("account_number")
  cardNumber        BigInt?            @map("card_number")
  driverHistory     DriverHistory[]    @relation("driver_to_driver_history")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  user              User?              @relation("user_to_driver_profile", fields: [userId], references: [uuid], onDelete: Cascade)
  userId            String?            @unique @map("user_id")

  @@map("driver_profile")
}
