model DriverOrderNotification {
  uuid      String                 @id @default(uuid()) @map("uuid")
  orderId   String                 @map("order_id")
  order     Order                  @relation(fields: [orderId], references: [uuid], onDelete: Cascade)
  driverId  String                 @map("driver_id")
  driver    User                   @relation(fields: [driverId], references: [uuid], onDelete: Cascade)
  title     String                 @map("title")
  message   String                 @map("message")
  isRead    Boolean                @default(false) @map("is_read")
  status    DriverAcceptanceStatus @default(PENDING) @map("status")
  createdAt DateTime               @default(now()) @map("created_at")
  type      String                 @default("action") @map("type") // Добавлено поле type

  @@map("driver_order_notifications")
}
