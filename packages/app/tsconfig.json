{
  "extends": "../../tsconfig.base",
  "include": [
    "./**/*",
    "../pages/**/*",
    "../widgets/**/*",
    "../features/**/*",
    "../entities/**/*",
    "../shared/**/*"
  ],
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": ".",
    "rootDirs": [
      ".",
      "../shared",
      "../widgets",
      "../entities",
      "../features"
    ],
    "paths": {
      "@app/*": ["./*"],
      "@widgets/*": ["../widgets/*"],
      "@shared/*": ["../shared/*"],
      "@entities/*": ["../entities/*"],
      "@features/*": ["../features/*"],
      "@socket": ["../../apps/next-app/src/socket.js"]
    }
  }
}
