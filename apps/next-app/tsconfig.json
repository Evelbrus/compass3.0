{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "baseUrl": ".",
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@socket/*": ["src/socket.js"],
      "@public/*": ["public/*"],
      "@app/*": ["../../packages/app/*"],
      "@pages/*": ["../../packages/pages/*"],
      "@widgets/*": ["../../packages/widgets/*"],
      "@features/*": ["../../packages/features/*"],
      "@entities/*": ["../../packages/entities/*"],
      "@shared/*": ["../../packages/shared/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "declarations.d.ts",
    "src/socket.js",
    "../../packages/pages/**/*",
    "../../packages/widgets/**/*",
    "../../packages/features/**/*",
    "../../packages/entities/**/*",
    "../../packages/shared/**/*"
  ],
  "exclude": ["node_modules"]
}
