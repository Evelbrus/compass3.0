{
  "name": "compass",
  "private": true,
  "module": "index.ts",
  "type": "module",
  "workspaces": [
    "./apps/*",
    "./packages/*"
  ],
  "scripts": {
    "dev": "yarn workspace next-app dev",
    "start": "node packages/shared/lib/web-socket/websocketServer.js",
    "prod": "yarn workspace next-app build",
    "serve": "yarn workspace next-app start",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --fix --ext .js,.jsx,.ts,.tsx",
    "lint:timing": "eslint . --ext .js,.jsx,.ts,.tsx",
    "format": "prettier --write .",
    "format:clean": "node remove-comments.mjs",
    "convert": "node convert.mjs",
    "prisma:drop": "cd packages/shared/prisma/schema/ && npx prisma migrate reset --force --skip-seed",
    "generate:profile-routes": "node packages/shared/utils/protected-path-logic-nodeJS/generateProfileRoutes.js",
    "generate:cookie-name": "node packages/shared/utils/cookie/generate-cookie/generateCookieFiles.js"
  },
  "prisma": {
    "schema": "./packages/shared/prisma/schema",
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} packages/shared/prisma/seed/seed.ts"
  },
  "packageManager": "yarn@4.4.1",
  "dependencies": {
    "@babel/generator": "^7.26.3",
    "@babel/parser": "^7.26.3",
    "@babel/traverse": "^7.26.4",
    "@prisma/client": "^6.1.0",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/typography": "^0.5.15",
    "axios": "^1.7.7",
    "bcrypt": "^5.1.1",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "critters": "^0.0.25",
    "debug": "^4.4.0",
    "effector": "^23.2.3",
    "effector-react": "^23.2.1",
    "flatpickr": "^4.6.13",
    "formidable": "^3.5.2",
    "fp-ts": "^2.16.9",
    "framer-motion": "^11.11.11",
    "jose": "^5.9.6",
    "jscodeshift": "^17.1.1",
    "next": "^15.0.2",
    "next-auth": "^4.24.11",
    "next-intl": "^3.23.5",
    "path-to-regexp": "^8.2.0",
    "patronum": "^2.3.0",
    "react": "19.0.0-rc-0bc30748-20241028",
    "react-datepicker": "^7.5.0",
    "react-dom": "19.0.0-rc-0bc30748-20241028",
    "react-hook-form": "^7.53.1",
    "react-select": "^5.8.2",
    "react-toastify": "^10.0.6",
    "sanitize-html": "^2.13.1",
    "sass": "^1.80.5",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "swiper": "^11.1.14",
    "uuid": "^11.0.3",
    "ws": "^8.18.0",
    "zod": "^3.23.8",
    "zxcvbn": "^4.4.2"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.9",
    "@types/babel__generator": "^7",
    "@types/babel__traverse": "^7",
    "@types/bcrypt": "^5",
    "@types/bcryptjs": "^2",
    "@types/debug": "^4",
    "@types/eslint-plugin-tailwindcss": "^3",
    "@types/formidable": "^3",
    "@types/node": "^20",
    "@types/react": "npm:types-react@19.0.0-rc.1",
    "@types/react-dom": "npm:types-react-dom@19.0.0-rc.1",
    "@types/sanitize-html": "^2",
    "@types/ws": "^8.5.13",
    "@types/zxcvbn": "^4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.16.0",
    "eslint-config-next": "15.0.2",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-tailwindcss": "^3.17.5",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "prettier-plugin-prisma": "^5.0.0",
    "prisma": "^6.1.0",
    "prisma-merge": "^0.2.0",
    "stylelint": "^16.10.0",
    "stylelint-config-standard": "^36.0.1",
    "stylelint-config-standard-scss": "^13.1.0",
    "stylelint-scss": "^6.8.1",
    "tailwindcss": "^3.4.16",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "typescript-plugin-css-modules": "^5.1.0"
  }
