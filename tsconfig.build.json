{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "outDir": "./apps/next-app/dist",
    "baseUrl": ".",
    "paths": {
      "@next-app/*": ["./apps/next-app/*"],
      "@shared/prisma/*": ["./packages/shared/prisma/*"]
    },
    "incremental": true,
    "tsBuildInfoFile": "./apps/next-app/dist/tsconfig.tsbuildinfo"
  },
  "include": [
    "./apps/next-app/src/lib/queues/dashboard-bull.ts",
    "./apps/next-app/src/lib/websocket/websocket-server.ts",
    "./apps/next-app/src/lib/queues/orderQueue.ts",
    "./apps/next-app/src/services/notifications/**/*.ts",
    "./packages/shared/prisma/seed/additional-service/additionalServiceSeed.ts",
    "./packages/shared/prisma/seed/point/pointSeed.ts",
    "./packages/shared/prisma/seed/user/userSeed.ts",
    "./packages/shared/prisma/seed/vehicle/vehicleSeed.ts",
    "./packages/shared/prisma/seed/seed.ts"
  ],
  "exclude": ["node_modules"]
}
