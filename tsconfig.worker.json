// tsconfig.worker.json
{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "outDir": "./apps/next-app/worker-dist",
    "baseUrl": ".",
    "paths": {
      "@shared/prisma/*": ["./packages/shared/prisma/*"],
    }
  },
  "include": [
    "./apps/next-app/worker.ts",
    "./apps/next-app/server.ts",
    "./apps/next-app/src/lib/queues/orderQueue.ts"
  ],
  "exclude": ["node_modules"]
}
